---
import Layout from '@/layouts/Layout.astro';
import {
  CONTACT_EMAIL,
  OGR_MARKETPLACE_URL,
  SOCIAL_INSTAGRAM_URL,
  SOCIAL_LINKEDIN_URL,
} from '@/data/landing';
---

<Layout title="Justin Fassio — Outdoor Lifestyle Rep">
  <div class="landing bg-bg text-ink overflow-x-hidden font-body">
    <nav
      class="landing-nav mx-auto flex max-w-[1240px] items-center gap-6.1 px-8.1 py-4.1"
    >
      <a
        href="#top"
        class="font-heading mr-auto text-[19px] tracking-[0.01em] text-ink no-underline"
      >
        JUSTIN FASSIO
      </a>

      <input id="nav-toggle" type="checkbox" class="landing-nav__toggle peer sr-only" />
      <label
        for="nav-toggle"
        class="landing-nav__burger ml-auto inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-divider bg-bg text-accent-2-900 md:hidden"
        aria-label="Open menu"
      >
        <span class="landing-nav__burger-icon" aria-hidden="true"></span>
      </label>

      <div
        class="landing-nav__links peer-checked:flex absolute top-[4.25rem] right-8.1 left-8.1 z-20 hidden flex-col gap-4 rounded-xl border border-divider bg-bg p-4.1 shadow-md md:static md:flex md:flex-row md:items-center md:gap-6.1 md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      >
        <a
          href="#brands"
          class="nav-link text-sm font-semibold text-ink no-underline hover:text-accent-2-900"
          >Brands</a
        >
        <a
          href="#apps"
          class="nav-link text-sm font-semibold text-ink no-underline hover:text-accent-2-900"
          >Apps</a
        >
        <a
          href="#contact"
          class="nav-link text-sm font-semibold text-ink no-underline hover:text-accent-2-900"
          >Contact</a
        >
        <a
          href="/login"
          class="inline-flex items-center justify-center rounded-full bg-accent-2-900 px-4.1 py-2.1 font-heading text-sm text-bg no-underline hover:bg-accent-2-800"
        >
          Sign In
        </a>
      </div>
    </nav>

    <!-- HERO -->
    <section id="top" class="mx-auto max-w-[1240px] px-8.1 pt-8.1 pb-[calc(var(--spacing-8\.1)*1.2)]">
      <div class="hero-grid grid items-center gap-8.1 md:grid-cols-[420px_1fr]">
        <div
          class="hero-logo badge-ring flex h-[min(380px,85vw)] w-[min(380px,85vw)] items-center justify-center justify-self-center p-4.1 md:justify-self-start"
        >
          <img
            src="/images/Outdoor_Lifestyle_Rep_Logo.png"
            alt="Justin Fassio - Outdoor Lifestyle Rep"
            class="h-full w-full rounded-full object-contain"
            width="380"
            height="380"
          />
        </div>
        <div>
          <span
            class="inline-flex items-center rounded-full bg-accent-2-100 px-2.5 py-[3px] font-heading text-[11px] tracking-[0.08em] text-accent-2-800 uppercase"
          >
            EST. SANTA CRUZ, CA
          </span>
          <h1 class="mt-3.1 text-[clamp(2.25rem,5vw,3.5rem)] text-accent-2-900">
            Outdoor Lifestyle Rep
          </h1>
          <p class="mt-0 max-w-[520px] text-lg text-ink/80">
            Independent sales rep connecting surf, bike, fish, and snow brands with the independent
            shops that carry them — up and down the coast and beyond.
          </p>
          <div class="mt-4.1 flex flex-wrap gap-3.1">
            <a
              href="#brands"
              class="inline-flex items-center justify-center rounded-full bg-accent-700 px-6.1 py-3.1 font-heading text-[15px] text-bg no-underline hover:bg-accent-600"
            >
              View Brands
            </a>
            <a
              href="#contact"
              class="inline-flex items-center justify-center rounded-full border border-accent-2-900 px-6.1 py-3.1 font-heading text-[15px] text-accent-2-900 no-underline hover:bg-ink/[0.07]"
            >
              Get In Touch
            </a>
          </div>
          <div class="mt-6.1 flex flex-wrap gap-4.1">
            {
              ['Surf', 'Bike', 'Fish', 'Snow'].map((label) => (
                <span class="inline-flex items-center rounded-full border border-accent-2-700 px-2.5 py-[3px] text-[11px] tracking-wide text-accent-2-800">
                  {label}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- BRANDS -->
    <section id="brands" class="bg-accent-2-900 px-8.1 py-[calc(var(--spacing-8\.1)*1.3)]">
      <div class="mx-auto max-w-[1240px]">
        <span
          class="inline-flex items-center rounded-full bg-accent-300 px-2.5 py-[3px] text-[11px] tracking-wide text-accent-900"
        >
          Line Card
        </span>
        <h2 class="mt-3.1 text-[34px] text-bg">Brands I Represent</h2>
        <p class="mb-6.1 max-w-[520px] text-bg/75">
          The lines I carry into shops today, with more joining the roster soon.
        </p>
        <div class="brand-grid grid gap-6.1 md:grid-cols-2">
          <article
            class="brand-card elev-md flex flex-col gap-3.1 rounded-xl bg-bg p-4.1 shadow-md"
          >
            <div
              class="flex h-40 w-full items-center justify-center rounded-md bg-surface text-center text-xs text-ink/45"
              role="img"
              aria-label="Old Guys Rule image placeholder"
            >
              Drop Old Guys Rule logo/lookbook image
            </div>
            <div class="flex flex-wrap items-center gap-2.1">
              <span class="font-heading text-xl leading-tight">Old Guys Rule</span>
              <span
                class="inline-flex items-center rounded-full bg-accent-2-100 px-2.5 py-[3px] text-[11px] tracking-wide text-accent-2-800"
              >
                Now Repping
              </span>
            </div>
            <p class="m-0 text-sm text-ink/70">
              Apparel & lifestyle goods for the surf and skate crowd.
            </p>
            <a
              href={OGR_MARKETPLACE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="brand-cta inline-flex items-center justify-center self-start rounded-full bg-accent-700 px-4.1 py-2.1 font-heading text-sm text-bg no-underline hover:bg-accent-600"
            >
              View Line
            </a>
          </article>

          <article
            class="brand-card elev-sm flex flex-col gap-3.1 rounded-xl bg-bg p-4.1 opacity-85 shadow-sm"
          >
            <div
              class="flex h-40 w-full items-center justify-center rounded-md bg-surface text-center text-xs text-ink/45"
              role="img"
              aria-label="Busted Knuckles Garage image placeholder"
            >
              Drop Busted Knuckles Garage image
            </div>
            <div class="flex flex-wrap items-center gap-2.1">
              <span class="font-heading text-xl leading-tight">Busted Knuckles Garage</span>
              <span
                class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-[3px] text-[11px] tracking-wide text-neutral-800"
              >
                Soon
              </span>
            </div>
            <p class="m-0 text-sm text-ink/70">Moto-inspired apparel joining the line card soon.</p>
            <span
              class="inline-flex cursor-default items-center justify-center self-start rounded-full border border-divider px-4.1 py-2.1 font-heading text-sm text-ink/70 opacity-70"
              aria-disabled="true"
            >
              Coming Soon
            </span>
          </article>
        </div>
      </div>
    </section>

    <!-- APPS -->
    <section id="apps" class="mx-auto max-w-[1240px] px-8.1 py-[calc(var(--spacing-8\.1)*1.3)]">
      <span
        class="inline-flex items-center rounded-full bg-accent-100 px-2.5 py-[3px] text-[11px] tracking-wide text-accent-800"
      >
        Tools
      </span>
      <h2 class="mt-3.1 text-[34px] text-accent-2-900">Command Centers</h2>
      <p class="mb-6.1 max-w-[520px] text-ink/75">
        Field tools for running the territory. Each app has its own sign-in.
      </p>
      <div class="grid grid-cols-1 gap-6.1 md:max-w-[420px]">
        <article
          class="app-card flex flex-col gap-3.1 rounded-xl border border-divider bg-bg p-6.1 shadow-md"
        >
          <div
            class="flex h-[52px] w-[52px] items-center justify-center rounded-full bg-accent-2-100"
          >
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="text-accent-2-800"
              stroke-width="2.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="M3 10h18"></path>
              <path d="M8 4v16"></path>
            </svg>
          </div>
          <span class="font-heading text-xl leading-tight">Rep Command Center</span>
          <p class="m-0 text-sm text-ink/70">
            Catalog, prospect directory, call pipeline, and order tools for the road.
          </p>
          <div class="mt-2.1 flex flex-wrap items-center gap-3.1">
            <a
              href="/app"
              class="inline-flex items-center justify-center rounded-full bg-accent-700 px-4.1 py-2.1 font-heading text-sm text-bg no-underline hover:bg-accent-600"
            >
              Open App
            </a>
            <span class="flex items-center gap-1.5 text-xs text-ink/55">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              Sign-in required
            </span>
          </div>
        </article>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="bg-accent-2-900 px-8.1 py-[calc(var(--spacing-8\.1)*1.3)]">
      <div
        class="mx-auto flex max-w-[1240px] flex-wrap items-end justify-between gap-6.1"
      >
        <div>
          <span
            class="inline-flex items-center rounded-full bg-accent-300 px-2.5 py-[3px] text-[11px] tracking-wide text-accent-900"
          >
            Get In Touch
          </span>
          <h2 class="mt-3.1 text-[32px] text-bg">Let's talk territory.</h2>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-lg font-semibold text-accent-300 no-underline hover:text-accent-200"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
        <div class="flex gap-3.1">
          <a
            href={SOCIAL_INSTAGRAM_URL}
            class="social-btn flex h-11 w-11 items-center justify-center rounded-full bg-accent-2-800 text-bg no-underline hover:bg-accent-2-700"
            aria-label="Instagram"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M17.5 6.5h.01"></path>
            </svg>
          </a>
          <a
            href={SOCIAL_LINKEDIN_URL}
            class="social-btn flex h-11 w-11 items-center justify-center rounded-full bg-accent-2-800 text-bg no-underline hover:bg-accent-2-700"
            aria-label="LinkedIn"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8Z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </div>
      </div>
      <div
        class="mx-auto mt-8.1 flex max-w-[1240px] flex-wrap justify-between gap-2.1 border-t border-accent-2-700 pt-4.1"
      >
        <span class="text-xs text-bg/65">© 2026 Justin Fassio · Santa Cruz, CA</span>
        <span class="text-xs text-bg/65">Surf · Bike · Fish · Snow</span>
      </div>
    </section>
  </div>
</Layout>

<style>
  .badge-ring {
    border: 2px dashed color-mix(in srgb, var(--color-accent-2-900) 35%, transparent);
    border-radius: 999px;
  }

  .brand-card:hover .brand-cta {
    background: var(--color-accent-600);
  }

  .app-card {
    transition:
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .landing-nav {
    position: relative;
  }

  .landing-nav__burger-icon,
  .landing-nav__burger-icon::before,
  .landing-nav__burger-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .landing-nav__burger-icon {
    position: relative;
  }

  .landing-nav__burger-icon::before,
  .landing-nav__burger-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .landing-nav__burger-icon::before {
    top: -6px;
  }

  .landing-nav__burger-icon::after {
    top: 6px;
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon {
    background: transparent;
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
    }

    .hero-logo {
      justify-self: center !important;
    }

    .brand-grid {
      grid-template-columns: 1fr !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card {
      transition: none;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
