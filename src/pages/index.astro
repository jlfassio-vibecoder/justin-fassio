---
import Layout from '@/layouts/Layout.astro';
import {
  CONTACT_EMAIL,
  OGR_WHOLESALE_PATH,
  SOCIAL_INSTAGRAM_URL,
  SOCIAL_LINKEDIN_URL,
} from '@/data/landing';

const instagramLive = SOCIAL_INSTAGRAM_URL !== '#';
const linkedInLive = SOCIAL_LINKEDIN_URL !== '#';
---

<Layout title="Justin Fassio — Outdoor Lifestyle Rep">
  <main class="landing bg-bg text-ink font-body overflow-x-hidden">
    <nav
      class="landing-nav gap-6.1 px-8.1 py-4.1 mx-auto flex max-w-[1240px] items-center"
      aria-label="Primary"
    >
      <a
        href="#top"
        class="font-heading text-ink mr-auto text-[19px] tracking-[0.01em] no-underline"
      >
        JUSTIN FASSIO
      </a>

      <input
        id="nav-toggle"
        type="checkbox"
        class="landing-nav__toggle peer sr-only"
        aria-controls="primary-nav-links"
      />
      <label
        for="nav-toggle"
        class="landing-nav__burger peer-focus-visible:outline-accent border-divider bg-bg text-accent-2-900 ml-auto inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 md:hidden"
      >
        <span class="sr-only">Open menu</span>
        <span class="landing-nav__burger-icon" aria-hidden="true"></span>
      </label>

      <div
        id="primary-nav-links"
        class="landing-nav__links right-8.1 left-8.1 border-divider bg-bg p-4.1 md:gap-6.1 absolute top-[4.25rem] z-20 hidden flex-col gap-4 rounded-xl border shadow-md peer-checked:flex md:static md:flex md:flex-row md:items-center md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      >
        <a
          href="#brands"
          class="nav-link text-ink hover:text-accent-2-900 text-sm font-semibold no-underline"
          >Brands</a
        >
        <a
          href="#apps"
          class="nav-link text-ink hover:text-accent-2-900 text-sm font-semibold no-underline"
          >Apps</a
        >
        <a
          href="#contact"
          class="nav-link text-ink hover:text-accent-2-900 text-sm font-semibold no-underline"
          >Contact</a
        >
        <a
          href="/rep-login"
          class="bg-accent-2-900 px-4.1 py-2.1 font-heading text-bg hover:bg-accent-2-800 inline-flex items-center justify-center rounded-full text-sm no-underline"
        >
          Sign In
        </a>
      </div>
    </nav>

    <!-- HERO -->
    <section
      id="top"
      class="px-8.1 pt-8.1 mx-auto max-w-[1240px] pb-[calc(var(--spacing-8\.1)*1.2)]"
    >
      <div class="hero-grid gap-8.1 grid items-center md:grid-cols-[420px_1fr]">
        <div
          class="hero-logo badge-ring p-4.1 flex h-[min(380px,85vw)] w-[min(380px,85vw)] items-center justify-center justify-self-center md:justify-self-start"
        >
          <img
            src="/images/Outdoor_Lifestyle_Rep_Logo.png"
            alt="Justin Fassio - Outdoor Lifestyle Rep"
            class="h-full w-full rounded-full object-contain"
            width="380"
            height="380"
          />
        </div>
        <div>
          <span
            class="bg-accent-2-100 font-heading text-accent-2-800 inline-flex items-center rounded-full px-2.5 py-[3px] text-[11px] tracking-[0.08em] uppercase"
          >
            EST. SANTA CRUZ, CA
          </span>
          <h1 class="mt-3.1 text-accent-2-900 text-[clamp(2.25rem,5vw,3.5rem)]">
            Outdoor Lifestyle Rep
          </h1>
          <p class="text-ink/80 mt-0 max-w-[520px] text-lg">
            Independent sales rep connecting surf, bike, fish, and snow brands with the independent
            shops that carry them — up and down the coast and beyond.
          </p>
          <div class="mt-4.1 gap-3.1 flex flex-wrap">
            <a
              href="#brands"
              class="bg-accent-700 px-6.1 py-3.1 font-heading text-bg hover:bg-accent-600 inline-flex items-center justify-center rounded-full text-[15px] no-underline"
            >
              View Brands
            </a>
            <a
              href="#contact"
              class="border-accent-2-900 px-6.1 py-3.1 font-heading text-accent-2-900 hover:bg-ink/[0.07] inline-flex items-center justify-center rounded-full border text-[15px] no-underline"
            >
              Get In Touch
            </a>
          </div>
          <div class="mt-6.1 gap-4.1 flex flex-wrap">
            {
              ['Surf', 'Bike', 'Fish', 'Snow'].map((label) => (
                <span class="border-accent-2-700 text-accent-2-800 inline-flex items-center rounded-full border px-2.5 py-[3px] text-[11px] tracking-wide">
                  {label}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- BRANDS -->
    <section id="brands" class="bg-accent-2-900 px-8.1 py-[calc(var(--spacing-8\.1)*1.3)]">
      <div class="mx-auto max-w-[1240px]">
        <span
          class="bg-accent-300 text-accent-900 inline-flex items-center rounded-full px-2.5 py-[3px] text-[11px] tracking-wide"
        >
          Line Card
        </span>
        <h2 class="mt-3.1 text-bg text-[34px]">Brands I Represent</h2>
        <p class="mb-6.1 text-bg/75 max-w-[520px]">
          The lines I carry into shops today, with more joining the roster soon.
        </p>
        <div class="brand-grid gap-6.1 grid md:grid-cols-2">
          <article
            class="brand-card elev-md gap-3.1 bg-bg p-4.1 flex flex-col rounded-xl shadow-md"
          >
            <div
              class="bg-surface text-ink/45 flex h-40 w-full items-center justify-center rounded-md text-center text-xs"
              role="img"
              aria-label="Old Guys Rule image placeholder"
            >
              Drop Old Guys Rule logo/lookbook image
            </div>
            <div class="gap-2.1 flex flex-wrap items-center">
              <span class="font-heading text-xl leading-tight">Old Guys Rule</span>
              <span
                class="bg-accent-2-100 text-accent-2-800 inline-flex items-center rounded-full px-2.5 py-[3px] text-[11px] tracking-wide"
              >
                Now Repping
              </span>
            </div>
            <p class="text-ink/70 m-0 text-sm">
              Apparel & lifestyle goods for the surf and skate crowd.
            </p>
            <a
              href={OGR_WHOLESALE_PATH}
              class="brand-cta bg-accent-700 px-4.1 py-2.1 font-heading text-bg hover:bg-accent-600 inline-flex items-center justify-center self-start rounded-full text-sm no-underline"
            >
              View Line
            </a>
          </article>

          <article
            class="brand-card elev-sm gap-3.1 bg-bg p-4.1 flex flex-col rounded-xl opacity-85 shadow-sm"
          >
            <div
              class="bg-surface text-ink/45 flex h-40 w-full items-center justify-center rounded-md text-center text-xs"
              role="img"
              aria-label="Busted Knuckles Garage image placeholder"
            >
              Drop Busted Knuckles Garage image
            </div>
            <div class="gap-2.1 flex flex-wrap items-center">
              <span class="font-heading text-xl leading-tight">Busted Knuckles Garage</span>
              <span
                class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-[3px] text-[11px] tracking-wide text-neutral-800"
              >
                Soon
              </span>
            </div>
            <p class="text-ink/70 m-0 text-sm">Moto-inspired apparel joining the line card soon.</p>
            <span
              class="border-divider px-4.1 py-2.1 font-heading text-ink/70 inline-flex cursor-default items-center justify-center self-start rounded-full border text-sm opacity-70"
              aria-disabled="true"
            >
              Coming Soon
            </span>
          </article>
        </div>
      </div>
    </section>

    <!-- APPS -->
    <section id="apps" class="px-8.1 mx-auto max-w-[1240px] py-[calc(var(--spacing-8\.1)*1.3)]">
      <span
        class="bg-accent-100 text-accent-800 inline-flex items-center rounded-full px-2.5 py-[3px] text-[11px] tracking-wide"
      >
        Tools
      </span>
      <h2 class="mt-3.1 text-accent-2-900 text-[34px]">Command Centers</h2>
      <p class="mb-6.1 text-ink/75 max-w-[520px]">
        Field tools for running the territory. Each app has its own sign-in.
      </p>
      <div class="gap-6.1 grid grid-cols-1 md:max-w-[420px]">
        <article
          class="app-card gap-3.1 border-divider bg-bg p-6.1 flex flex-col rounded-xl border shadow-md"
        >
          <div
            class="bg-accent-2-100 flex h-[52px] w-[52px] items-center justify-center rounded-full"
          >
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="text-accent-2-800"
              stroke-width="2.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="M3 10h18"></path>
              <path d="M8 4v16"></path>
            </svg>
          </div>
          <span class="font-heading text-xl leading-tight">Rep Command Center</span>
          <p class="text-ink/70 m-0 text-sm">
            Catalog, prospect directory, call pipeline, and order tools for the road.
          </p>
          <div class="mt-2.1 gap-3.1 flex flex-wrap items-center">
            <a
              href="/rep-login"
              class="bg-accent-700 px-4.1 py-2.1 font-heading text-bg hover:bg-accent-600 inline-flex items-center justify-center rounded-full text-sm no-underline"
            >
              Open App
            </a>
            <span class="text-ink/55 flex items-center gap-1.5 text-xs">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              Sign-in required
            </span>
          </div>
        </article>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="bg-accent-2-900 px-8.1 py-[calc(var(--spacing-8\.1)*1.3)]">
      <div class="gap-6.1 mx-auto flex max-w-[1240px] flex-wrap items-end justify-between">
        <div>
          <span
            class="bg-accent-300 text-accent-900 inline-flex items-center rounded-full px-2.5 py-[3px] text-[11px] tracking-wide"
          >
            Get In Touch
          </span>
          <h2 class="mt-3.1 text-bg text-[32px]">Let's talk territory.</h2>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-accent-300 hover:text-accent-200 text-lg font-semibold no-underline"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
        <div class="gap-3.1 flex">
          {
            instagramLive ? (
              <a
                href={SOCIAL_INSTAGRAM_URL}
                class="social-btn bg-accent-2-800 text-bg hover:bg-accent-2-700 flex h-11 w-11 items-center justify-center rounded-full no-underline"
                aria-label="Instagram"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <path d="M17.5 6.5h.01" />
                </svg>
              </a>
            ) : (
              <span
                class="social-btn bg-accent-2-800 text-bg flex h-11 w-11 items-center justify-center rounded-full opacity-70"
                aria-label="Instagram (coming soon)"
                role="img"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <path d="M17.5 6.5h.01" />
                </svg>
              </span>
            )
          }
          {
            linkedInLive ? (
              <a
                href={SOCIAL_LINKEDIN_URL}
                class="social-btn bg-accent-2-800 text-bg hover:bg-accent-2-700 flex h-11 w-11 items-center justify-center rounded-full no-underline"
                aria-label="LinkedIn"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8Z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              </a>
            ) : (
              <span
                class="social-btn bg-accent-2-800 text-bg flex h-11 w-11 items-center justify-center rounded-full opacity-70"
                aria-label="LinkedIn (coming soon)"
                role="img"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8Z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              </span>
            )
          }
        </div>
      </div>
      <div
        class="mt-8.1 gap-2.1 border-accent-2-700 pt-4.1 mx-auto flex max-w-[1240px] flex-wrap justify-between border-t"
      >
        <span class="text-bg/65 text-xs">© 2026 Justin Fassio · Santa Cruz, CA</span>
        <span class="text-bg/65 text-xs">Surf · Bike · Fish · Snow</span>
      </div>
    </section>
  </main>
</Layout>

<style>
  .badge-ring {
    border: 2px dashed color-mix(in srgb, var(--color-accent-2-900) 35%, transparent);
    border-radius: 999px;
  }

  .brand-card:hover .brand-cta {
    background: var(--color-accent-600);
  }

  .app-card {
    transition:
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .landing-nav {
    position: relative;
  }

  .landing-nav__burger-icon,
  .landing-nav__burger-icon::before,
  .landing-nav__burger-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .landing-nav__burger-icon {
    position: relative;
  }

  .landing-nav__burger-icon::before,
  .landing-nav__burger-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .landing-nav__burger-icon::before {
    top: -6px;
  }

  .landing-nav__burger-icon::after {
    top: 6px;
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon {
    background: transparent;
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .landing-nav__toggle:checked + .landing-nav__burger .landing-nav__burger-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
    }

    .hero-logo {
      justify-self: center !important;
    }

    .brand-grid {
      grid-template-columns: 1fr !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card {
      transition: none;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
