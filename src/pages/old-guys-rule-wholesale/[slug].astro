---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { WholesaleProductPage } from '@/components/wholesale/WholesaleProductPage';
import { fetchPublicActiveLines } from '@/lib/lines';
import {
  fetchPublicOgrProductBySlug,
  fetchPublicOgrSupplierTerms,
  type PublicOgrSupplierTerms,
} from '@/lib/publicCatalog';
import { buildOgrProductMetadata, toLayoutSeoProps } from '@/lib/ogrPageMetadata';
import { resolveOgrProductShareImage } from '@/lib/ogrShareImages';
import { buildPublicProductPresentation } from '@/lib/publicProductPresentation';
import { buildOgrProductUrl, resolvePublicSiteOrigin } from '@/lib/productUrls';
import { resolvePublicOgrProductPageResponse } from '@/lib/wholesaleRoutes';

const slug = Astro.params.slug ?? '';
const [{ data: product, error: productError }, { data: terms }, { data: lines }] =
  await Promise.all([
    fetchPublicOgrProductBySlug(slug),
    fetchPublicOgrSupplierTerms(),
    fetchPublicActiveLines(),
  ]);

const earlyResponse = resolvePublicOgrProductPageResponse({
  product,
  error: productError,
});
if (earlyResponse) {
  return earlyResponse;
}
if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const resolvedTerms: PublicOgrSupplierTerms = terms ?? {
  minOrderPieces: 24,
  minPiecesPerDesign: 6,
  defaultShippingMethod: '',
  pricesSubjectToChange: true,
};

const ogrLine = lines.find((line) => line.code === 'ogr') ?? null;
const presentation = buildPublicProductPresentation(product);
const shareImage = resolveOgrProductShareImage({
  presentation,
  lineHeroImageUrl: ogrLine?.heroImageUrl,
});
const canonicalUrl = buildOgrProductUrl(
  presentation.slug,
  resolvePublicSiteOrigin({ requestOrigin: Astro.url.origin }),
);
const seo = toLayoutSeoProps(
  buildOgrProductMetadata({
    presentation,
    canonicalUrl,
    image: shareImage,
  }),
);
---

<Layout {...seo}>
  <WholesaleProductPage client:load product={product} terms={resolvedTerms} />
</Layout>
