---
import '@/styles/global.css';
import { PublicChatFab } from '@/components/chat/PublicChatFab';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string | null;
  ogImageAlt?: string | null;
  ogSiteName?: string | null;
  ogType?: 'website';
  noIndex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogImageAlt,
  ogSiteName,
  ogType = 'website',
  noIndex = false,
} = Astro.props;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const path = Astro.url.pathname;
const isStaffSurface = path === '/app' || path.startsWith('/app/') || path === '/rep-login';
/** Marketing landing stays on soft cream light tokens — never inherits app dark theme. */
const forceLightTheme = path === '/';
---

<!doctype html>
<html lang="en" data-theme={forceLightTheme ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ forceLightTheme }}>
      try {
        if (forceLightTheme) {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          const t = localStorage.getItem('rcc-theme');
          document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
        }
      } catch {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    {noIndex ? <meta name="robots" content="noindex" /> : null}
    <link rel="canonical" href={resolvedCanonical} />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    {ogSiteName ? <meta property="og:site_name" content={ogSiteName} /> : null}
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    {ogImage && ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description ? <meta name="twitter:description" content={description} /> : null}
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
    {ogImage && ogImageAlt ? <meta name="twitter:image:alt" content={ogImageAlt} /> : null}
  </head>
  <body>
    <slot />
    {!isStaffSurface ? <PublicChatFab client:idle /> : null}
  </body>
</html>
