# Astro env conventions:
# - PUBLIC_*  → exposed to the browser (safe for non-secrets only)
# - other keys → server/build-time only; never import in client React islands
#
# Copy to `.env` for local use. Set the same keys in Vercel → Project → Settings →
# Environment Variables (Production / Preview / Development as needed).

# --- Client (public / anon — safe for React islands) ---
# Find these in your Supabase project: Project Settings > API.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional:
# PUBLIC_SITE_URL=https://justin-fassio.vercel.app

# --- Server / private (never use PUBLIC_ prefix; never import in client islands) ---
# Supabase service role — Edge Functions / privileged server ops only. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional local functions URL override (defaults to PROJECT_URL/functions/v1):
# SUPABASE_FUNCTIONS_URL=
# Vercel AI Gateway — local auth for /api/agent, enrich, and /api/pricing/landed-rates (web search + structured fields).
# On Vercel, OIDC is preferred; pull via `vercel env pull`.
# AI_GATEWAY_API_KEY=
# Resend API key — replace re_xxxxxxxxx with your real key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# Optional From for wholesale + OGR product outreach (else Justin Fassio <office@…>):
# WHOLESALE_ORDER_EMAIL_FROM=Justin Fassio <office@justinfassio.com>
# DATABASE_URL=
